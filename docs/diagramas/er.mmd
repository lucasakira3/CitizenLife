---
title: "Banco Oracle do Citizen Life: 10 tabelas"
---
erDiagram
    CL_CIDADAO ||--o{ CL_ROTA : "salva"
    CL_CIDADAO ||--o{ CL_ENDERECO : "guarda"
    CL_ROTA ||--|{ CL_ROTA_VIA : "passa por"
    CL_VIA ||--o{ CL_ROTA_VIA : "faz parte de"
    CL_VIA ||--o{ CL_OCORRENCIA : "tem"
    CL_CIDADAO ||--o{ CL_INSCRICAO_PROGRAMA : "registra"
    CL_PROGRAMA_MORADIA ||--o{ CL_INSCRICAO_PROGRAMA : "recebe"
    CL_CIDADAO ||--o{ CL_CONTATO_EMERGENCIA : "avisa"
    CL_CIDADAO ||--o{ CL_CIDADAO_FEIRA : "favorita"
    CL_FEIRA ||--o{ CL_CIDADAO_FEIRA : "é favorita de"

    CL_CIDADAO {
        NUMBER id_cidadao PK
        VARCHAR2 nome
        VARCHAR2 email UK
        VARCHAR2 senha_hash
        VARCHAR2 modal "CHECK, opcional"
        DATE dt_cadastro
    }
    CL_ROTA {
        NUMBER id_rota PK
        NUMBER id_cidadao FK
        VARCHAR2 nome "UK com id_cidadao"
        VARCHAR2 origem_descricao
        NUMBER origem_x
        NUMBER origem_y
        VARCHAR2 destino_descricao
        NUMBER destino_x
        NUMBER destino_y
        NUMBER distancia_m
        DATE dt_criacao
    }
    CL_ROTA_VIA {
        NUMBER id_rota PK,FK
        NUMBER id_via PK,FK
        NUMBER ordem
    }
    CL_VIA {
        NUMBER id_via PK
        VARCHAR2 nome UK
        VARCHAR2 zona "CHECK"
    }
    CL_OCORRENCIA {
        NUMBER id_ocorrencia PK
        NUMBER id_via FK
        VARCHAR2 titulo UK
        VARCHAR2 descricao
        VARCHAR2 tipo "CHECK"
        NUMBER gravidade "1 a 5"
        DATE dt_registro
    }
    CL_ENDERECO {
        NUMBER id_endereco PK
        NUMBER id_cidadao FK
        VARCHAR2 apelido "UK com id_cidadao"
        VARCHAR2 tipo "CHECK"
        VARCHAR2 descricao
        NUMBER pos_x
        NUMBER pos_y
    }
    CL_PONTO_APOIO {
        NUMBER id_ponto PK
        VARCHAR2 nome UK
        VARCHAR2 tipo "CHECK"
        VARCHAR2 bairro
        VARCHAR2 zona "CHECK"
        VARCHAR2 telefone
        CHAR aberto_24h "CHECK S/N"
        VARCHAR2 abre "HH:MM, opcional"
        VARCHAR2 fecha "HH:MM, opcional"
        NUMBER pos_x
        NUMBER pos_y
    }
    CL_CONTATO_EMERGENCIA {
        NUMBER id_contato PK
        NUMBER id_cidadao FK
        VARCHAR2 nome "UK com id_cidadao"
        VARCHAR2 telefone
        VARCHAR2 parentesco "opcional"
    }
    CL_FEIRA {
        NUMBER id_feira PK
        VARCHAR2 nome
        VARCHAR2 rua "UK com dia_semana"
        VARCHAR2 zona "CHECK"
        VARCHAR2 dia_semana "CHECK"
        VARCHAR2 horario
    }
    CL_CIDADAO_FEIRA {
        NUMBER id_cidadao PK,FK
        NUMBER id_feira PK,FK
    }
    CL_PROGRAMA_MORADIA {
        NUMBER id_programa PK
        VARCHAR2 nome UK
        VARCHAR2 tipo "CHECK"
        VARCHAR2 canal "CHECK"
        VARCHAR2 descricao
        VARCHAR2 quem_tem_direito
        NUMBER renda_maxima "opcional"
        VARCHAR2 documentos
        VARCHAR2 onde_inscrever
        VARCHAR2 site
    }
    CL_INSCRICAO_PROGRAMA {
        NUMBER id_inscricao PK
        NUMBER id_cidadao FK
        NUMBER id_programa FK
        VARCHAR2 status "CHECK"
        VARCHAR2 protocolo
        VARCHAR2 observacao
        DATE dt_inscricao
        DATE dt_atualizacao
    }
