---
title: "model: os dados do sistema (getters e setters omitidos)"
---
classDiagram
    direction LR
    class Cidadao {
        +String MODAL_PADRAO$
        -Long id
        -String nome
        -String email
        -String senhaHash
        -String modal
        -LocalDateTime dataCadastro
        +modalParaRisco() String
    }
    class Rota {
        -Long id
        -Long idCidadao
        -String nome
        -String origemDescricao
        -double origemX
        -double origemY
        -String destinoDescricao
        -double destinoX
        -double destinoY
        -int distanciaMetros
        -LocalDateTime dataCriacao
        -List~Via~ vias
        +passaPor(Long idVia) boolean
    }
    class Via {
        -Long id
        -String nome
        -String zona
    }
    class Endereco {
        +List~String~ TIPOS$
        -Long id
        -Long idCidadao
        -String apelido
        -String tipo
        -String descricao
        -double x
        -double y
        +isTipoUnico() boolean
    }
    class Ocorrencia {
        +List~String~ MODAIS$
        +double LIMITE_ALERTA$
        -Long id
        -String titulo
        -String descricao
        -String tipo
        -int gravidade
        -LocalDateTime dataRegistro
        -Via via
        +calcularRisco(String modal) double
        +nivel(double risco)$ String
    }
    class Feira {
        -Long id
        -String nome
        -String rua
        -String zona
        -String diaSemana
        -String horario
    }
    class PontoApoio {
        +List~String~ TIPOS$
        +int METROS_POR_UNIDADE$
        -Long id
        -String nome
        -String tipo
        -String bairro
        -String zona
        -String telefone
        -boolean aberto24h
        -String abre
        -String fecha
        -double x
        -double y
        +estaAberto(LocalTime agora) boolean
        +distanciaMetrosAte(double x, double y) int
    }
    class Horario {
        <<final>>
        +estaAberto(aberto24h, abre, fecha, LocalTime agora)$ boolean
    }
    class ProgramaMoradia {
        +List~String~ TIPOS$
        -Long id
        -String nome
        -String tipo
        -String canal
        -Double rendaMaxima
        +atendeRenda(double rendaFamiliar) boolean
        +listaDocumentos() List~String~
    }
    class InscricaoPrograma {
        +List~String~ STATUS$
        -Long id
        -Long idCidadao
        -ProgramaMoradia programa
        -String status
        -String protocolo
    }
    class LugarLazer {
        +List~String~ TIPOS$
        -Long id
        -String nome
        -String tipo
        -String bairro
        -String zona
        -boolean aberto24h
        -String abre
        -String fecha
        -double x
        -double y
        +estaAberto(LocalTime agora) boolean
        +distanciaMetrosAte(double x, double y) int
    }
    class EventoLazer {
        +List~String~ CATEGORIAS$
        -Long id
        -LugarLazer lugar
        -String titulo
        -String categoria
        -String descricao
        -LocalDateTime inicio
        -LocalDateTime fim
        +jaTerminou(LocalDateTime agora) boolean
        +acontecendo(LocalDateTime agora) boolean
        +comecaAte(LocalDateTime limite) boolean
    }
    class ContatoEmergencia {
        -Long id
        -Long idCidadao
        -String nome
        -String telefone
        -String parentesco
        +getTelefoneDigitos() String
    }
    Cidadao "1" --> "0..10" Rota : salva
    Cidadao "1" --> "0..10" Endereco : guarda
    Rota "*" --> "1..*" Via : passa por
    Ocorrencia "*" --> "1" Via : acontece em
    Cidadao "*" --> "*" Feira : favorita
    Cidadao "1" --> "0..5" ContatoEmergencia : avisa
    Cidadao "1" --> "*" InscricaoPrograma : registra
    InscricaoPrograma "*" --> "1" ProgramaMoradia : em
    EventoLazer "*" --> "1" LugarLazer : acontece em
    Cidadao "*" --> "0..20" EventoLazer : agenda
    PontoApoio ..> Horario
    LugarLazer ..> Horario
